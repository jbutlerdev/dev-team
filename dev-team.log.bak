s {\n\t//\tissues = append(issues, *issue)\n\t//}\n\n\t//err = json.NewEncoder(w).Encode(issues)\n\t//if err != nil {\n\t//\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t//\treturn\n\t//}\n\n\thttp.Error(w, \"Not Implemented\", http.StatusInternalServerError)\n}\n\nfunc HandleGitHubPullRequestEvent(w http.ResponseWriter, r *http.Request) {\n\tvar payload github.PullRequestEvent\n\terr := json.NewDecoder(r.Body).Decode(&payload)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding request body: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Get the repository path from the payload\n\trepositoryName := payload.Repository.Name\n\torganization := payload.Repository.Owner.Login\n\n\t// Construct the absolute path to the repository\n\t//absPath := filepath.Join(\"/path/to/repositories\", repositoryName) // Replace with the actual path\n\n\t//TODO fix this\n\tabsPath := filepath.Join(\"/data/jbutler/tmpgit/jbutlerdev/dev-team\", repositoryName)\n\n\tstate.State.Mu.RLock()\n\t_, exists := state.State.Repositories[absPath]\n\t//token := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tpr := payload.PullRequest\n\n\t// Check if the pull request has the \"dev-team\" label\n\thasDevTeamLabel := false\n\tfor _, label := range pr.Labels {\n\t\tif label.Name == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\t_, isTracked := state.State.TrackedPullRequests[pr.ID]\n\n\tswitch payload.Action {\n\tcase \"opened\", \"reopened\", \"labeled\", \"synchronize\":\n\t\tif hasDevTeamLabel {\n\t\t\t// Track the pull request\n\t\t\tif !isTracked {\n\t\t\t\tstate.State.Mu.Lock()\n\t\t\t\tstate.State.TrackedPullRequests[pr.ID] = &state.TrackedPullRequest{\n\t\t\t\t\tRepoPath:      absPath,\n\t\t\t\t\tPullRequestID: pr.ID,\n\t\t\t\t\tNumber:        pr.Number,\n\t\t\t\t}\n\t\t\t\tstate.State.Mu.Unlock()\n\t\t\t}\n\t\t}\n\tcase \"closed\", \"unlabeled\":\n\t\t// Check if the pull request was closed or the label was removed\n\t\tif !hasDevTeamLabel || payload.Action == \"closed\"{\n\t\t\t// Remove the pull request from the tracked state\n\t\t\tif isTracked {\n\t\t\t\tstate.State.Mu.Lock()\n\t\t\t\tdelete(state.State.TrackedPullRequests, pr.ID)\n\t\t\t\tstate.State.Mu.Unlock()\n\t\t\t}\n\t\t}\n\tcase \"created\":\n\t\t// Handle new comments on tracked pull requests\n\t\tif isTracked {\n\t\t\t// Add a commit to the pull request that addresses the comment\n\t\t\tcommentBody := payload.Comment.Body\n\t\t\tcommitMessage := fmt.Sprintf(\"Addressing comment: %s\", commentBody)\n\n\t\t\t// Use the github package to add the commit\n\t\t\terr := github.AddCommitToPullRequest(token, organization, repositoryName, pr.Number, commitMessage)\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, fmt.Sprintf(\"Error adding commit to pull request: %v\", err), http.StatusInternalServerError)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/handlers/github.go]}"}
