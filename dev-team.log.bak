{"level":"info","ts":1738786588.337013,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"0e8b7532-e326-4943-84b2-3cf914eedb3d","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package repository\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/google/go-github/v57/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/auth\"\n)\n\ntype Repository struct {\n\tPath          string           `json:\\\"path\\\"`\n\tBranches      map[string]*Branch `json:\\\"branches\\\"`\n\tIssues        map[int]*Issue     `json:\\\"issues\\\"`\n\tPullRequests  map[int]*PullRequest `json:\\\"pullRequests\\\"`\n\tMu            sync.RWMutex       `json:\\\"-\\\"`\n\tValid         bool             `json:\\\"valid\\\"`\n\tLastValidated string           `json:\\\"lastValidated\\\"`\n\tState         *RepoState       `json:\\\"state\\\"`\n\tSettingsPath string         `json:\\\"settingsPath\\\"`\n}\n\ntype RepoState struct {\n\tLastCommit string `json:\\\"lastCommit\\\"`\n}\n\nfunc (r *Repository) String() string {\n\treturn fmt.Sprintf(\"%s\", r.Path)\n}\n\nfunc NewRepository(path string) *Repository {\n\treturn &Repository{\n\t\tPath:         path,\n\t\tBranches:     make(map[string]*Branch),\n\t\tIssues:       make(map[int]*Issue),\n\t\tPullRequests: make(map[int]*PullRequest),\n\t\tMu:           sync.RWMutex{},\n\t\tState: &RepoState{\n\t\t\tLastCommit: \"\",\n\t\t},\n\t}\n}\n\nfunc (r *Repository) Validate() error {\n\t_, err := os.Stat(filepath.Join(r.Path, \".git\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\n\terr = r.validateBranches()\n\tif err != nil {\n\t\treturn err\n\t}\n\n\terr = r.validateSettings()\n\tif err != nil {\n\t\treturn err\n\t}\n\n\terr = r.updateRepoState()\n\tif err != nil {\n\t\treturn err\n\t}\n\n\treturn nil\n}\n\n\nfunc (r *Repository) UpdateIssues(token string) error {\n\tissues, err := r.fetchIssues(token)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tr.Mu.Lock()\n\tdefer r.Mu.Unlock()\n\n\tfor _, issue := range issues {\n\t\tcomments, err := r.fetchIssueComments(token, issue.GetNumber())\n\t\tif err != nil {\n\t\t\tfmt.Println(\"Error fetching issue comments\", err)\n\t\t\tcontinue\n\t\t}\n\n\t\tvar issueComments []IssueComment\n\n\t\tfor _, comment := range comments {\n\t\t\tissueComments = append(issueComments, *ConvertGitHubIssueComment(comment))\n\t\t}\n\n\t\tghIssue := ConvertGitHubIssue(issue, r.Path)\n\t\tghIssue.Comments = issueComments\n\t\t_, exists := r.Issues[ghIssue.Number]\n\t\tif !exists {\n\t\t\tr.Issues[ghIssue.Number] = ghIssue\n\t\t} else {\n\t\t\tr.Issues[ghIssue.Number].Comments = issueComments\n\t\t}\n\t}\n\n\treturn nil\n}\n\nfunc (r *Repository) fetchIssues(token string) ([]*github.Issue, error) {\n\tctx := context.Background()\n\n\tsource := auth.GetTokenSource(token)\n\thc := auth.GetHttpClient(ctx, source)\n\n\tclient, err := github.NewEnterpriseClient(\n\t\t\"https://github.example.com/api/v3\",\n\t\t\"https://github.example.com/api/v3\",\n\t\thc,\n\t)\n\n\tif os.Getenv(\"GITHUB_ACTIONS\") == \"true\" {\n\t\tclient = github.NewClient(hc)\n\t\terr = nil\n\t}\n\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\towner, name := r.getOwnerAndName()\n\n\tissues, _, err := client.Issues.ListByRepo(ctx, owner, name, nil)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn issues, nil\n}\n\nfunc (r *Repository) fetchIssueComments(token string, issueNumber int) ([]*github.IssueComment, error) {\n\tctx := context.Background()\n\n\tsource := auth.GetTokenSource(token)\n\thc := auth.GetHttpClient(ctx, source)\n\n\tclient, err := github.NewEnterpriseClient(\n\t\t\"https://github.example.com/api/v3\",\n\t\t\"https://github.example.com/api/v3\",\n\t\thc,\n\t)\n\n\tif os.Getenv(\"GITHUB_ACTIONS\") == \"true\" {\n\t\tclient = github.NewClient(hc)\n\t\terr = nil\n\t}\n\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\towner, name := r.getOwnerAndName()\n\n\tcomments, _, err := client.Issues.ListComments(ctx, owner, name, issueNumber, nil)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn comments, nil\n}\n\nfunc (r *Repository) getOwnerAndName() (string, string) {\n\tparts := strings.Split(r.Path, string(os.PathSeparator))\n\towner := parts[len(parts)-2]\n\tname := parts[len(parts)-1]\n\n\treturn owner, name\n}\n\nfunc (r *Repository) UpdatePullRequests(token string) error {\n\tprs, err := r.fetchPullRequests(token)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tr.Mu.Lock()\n\tdefer r.Mu.Unlock()\n\n\tfor _, pr := range prs {\n\t\tghPR := ConvertGitHubPullRequest(pr)\n\t\t_, exists := r.PullRequests[ghPR.Number]\n\t\tif !exists {\n\t\t\tr.PullRequests[ghPR.Number] = ghPR\n\t\t}\n\t}\n\n\treturn nil\n}\n\nfunc (r *Repository) fetchPullRequests(token string) ([]*github.PullRequest, error) {\n\tctx := context.Background()\n\n\tsource := auth.GetTokenSource(token)\n\thc := auth.GetHttpClient(ctx, source)\n\n\tclient, err := github.NewEnterpriseClient(\n\t\t\"https://github.example.com/api/v3\",\n\t\t\"https://github.example.com/api/v3\",\n\t\thc,\n\t)\n\n\tif os.Getenv(\"GITHUB_ACTIONS\") == \"true\" {\n\t\tclient = github.NewClient(hc)\n\t\terr = nil\n\t}\n\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\towner, name := r.getOwnerAndName()\n\n\tprs, _, err := client.PullRequests.List(ctx, owner, name, nil)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn prs, nil\n}\n\nfunc (r *Repository) updateRepoState() error {\n\thead, err := r.GetHead()\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tr.Mu.Lock()\n\tdefer r.Mu.Unlock()\n\n\tif r.State == nil {\n\t\tr.State = &RepoState{}\n\t}\n\n\tr.State.LastCommit = head\n\treturn nil\n}\n path:pkg/repository/repository.go]}"}
