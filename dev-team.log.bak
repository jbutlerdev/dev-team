.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\teventType := r.Header.Get(\"X-GitHub-Event\")\n\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\thandlePullRequestEvent(w, r)\n\tcase \"issue_comment\":\n\t\thandleIssueCommentEvent(w, r)\n\tdefault:\n\t\tw.WriteHeader(http.StatusOK)\n\t}\n}\n\nfunc handlePullRequestEvent(w http.ResponseWriter, r *http.Request) {\n\tvar event github.PullRequestEvent\n\terr := json.NewDecoder(r.Body).Decode(&event)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding pull request event: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Check if the pull request has the 'dev-team' label\n\thasDevTeamLabel := false\n\tfor _, label := range event.PullRequest.Labels {\n\t\tif label.Name == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\tif hasDevTeamLabel {\n\t\t// Track the pull request\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; !ok {\n\t\t\tstate.State.TrackedPullRequests[event.PullRequest.ID] = &state.TrackedPullRequest{\n\t\t\t\tRepoPath:      event.Repository.FullName,\n\t\t\t\tPullRequestID: event.PullRequest.ID,\n\t\t\t\t// Add other relevant information here\n\t\t\t}\n\t\t\tlog.Printf(\"Tracking pull request %d\", event.PullRequest.ID)\n\t\t}\n\t} else {\n\t\t// Stop tracking the pull request if it was previously tracked\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, event.PullRequest.ID)\n\t\t\tlog.Printf(\"No longer tracking pull request %d\", event.PullRequest.ID)\n\t\t}\n\t}\n\n\t// Also stop tracking if the PR is closed or merged\n\tif event.Action == \"closed\" || event.PullRequest.Merged {\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, event.PullRequest.ID)\n\t\t\tlog.Printf(\"No longer tracking pull request %d because it was closed or merged\", event.PullRequest.ID)\n\t\t}\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handleIssueCommentEvent(w http.ResponseWriter, r *http.Request) {\n\tvar event github.IssueCommentEvent\n\terr := json.NewDecoder(r.Body).Decode(&event)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding issue comment event: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Check if the comment is on a tracked pull request\n\tif _, ok := state.State.TrackedPullRequests[event.Issue.ID]; ok {\n\t\t// Add a new commit to the pull request that addresses the comment\n\t\t// This is where you would call the GitHub API to create a commit\n\t\t// and push it to the pull request's branch.\n\t\tlog.Printf(\"Adding commit to pull request %d in response to comment\", event.Issue.ID)\n\n\t\t// Placeholder for adding commit logic\n\t\tgithub.AddCommitToPullRequest(event.Repository.FullName, int(event.Issue.Number), event.Comment.Body)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n","path":"internal/handlers/github.go"}}
