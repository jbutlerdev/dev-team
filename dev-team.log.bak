fig/config.go:1: : import cycle not allowed in test (typecheck)\npackage config\ninternal/handlers/github.go:11:2: could not import github.com/jbutlerdev/dev-team/pkg/github (-: # github.com/jbutlerdev/dev-team/pkg/github\npkg/github/github.go:122:65: not enough arguments in call to client.Git.CreateCommit\n\thave (context.Context, string, string, *\"github.com/google/go-github/v57/github\".Commit)\n\twant (context.Context, string, string, *\"github.com/google/go-github/v57/github\".Commit, *\"github.com/google/go-github/v57/github\".CreateCommitOptions)) (typecheck)\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t^\ninternal/handlers/github.go:9:2: other declaration of github (typecheck)\n\t\"github.com/google/go-github/v57/github\"\n\t^\ninternal/handlers/repository.go:14:2: could not import github.com/jbutlerdev/dev-team/internal/config (-: import cycle not allowed: import stack: [github.com/jbutlerdev/dev-team/cmd/dev-team github.com/jbutlerdev/dev-team/internal/config github.com/jbutlerdev/dev-team/internal/state github.com/jbutlerdev/dev-team/internal/config]) (typecheck)\n\t\"github.com/jbutlerdev/dev-team/internal/config\"\n\t^\ninternal/handlers/github.go:20:23: undefined: github.FetchRepositories (typecheck)\n\trepos, err := github.FetchRepositories(token)\n\t                     ^\ninternal/handlers/github.go:81:25: undefined: github.ValidateWebhook (typecheck)\n\tpayload, err := github.ValidateWebhook(r, state.State.Settings.GitHubWebhookSecret)\n\t                       ^\ninternal/handlers/github.go:165:17: undefined: github.AddCommitToPullRequest (typecheck)\n\t\terr := github.AddCommitToPullRequest(token, repoName, issueNumber, commentBody)\n\t\t              ^\n"}
