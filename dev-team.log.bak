v-team/pkg/repository (-: # github.com/jbutlerdev/dev-team/pkg/repository\npkg/repository/repository.go:372:3: unknown field atts in struct literal of type ValidationInput\npkg/repository/repository.go:432:3: unknown field Branch in struct literal of type \"github.com/jbutlerdev/dev-team/pkg/github\".GitHubPRInput\npkg/repository/repository.go:434:3: unknown field Description in struct literal of type \"github.com/jbutlerdev/dev-team/pkg/github\".GitHubPRInput) (typecheck)\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n\t^\ninternal/handlers/repository.go:243:3: unknown field Branch in struct literal of type github.GitHubPRInput (typecheck)\n\t\tBranch:              repo.State.CurrentBranch,\n\t\t^\ninternal/handlers/repository.go:245:3: unknown field Description in struct literal of type github.GitHubPRInput (typecheck)\n\t\tDescription:         prDescription,\n\t\t^\n"}
