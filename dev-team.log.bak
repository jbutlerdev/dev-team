{"level":"info","ts":1738788358.553442,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"47db5c51-4d4b-406c-8e0d-0f9a6e6d0ab3","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package scheduler\n\nimport (\n\t\"context\"\n\t\"log\"\n\t\"sync\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/robfig/cron/v3\"\n)\n\ntype Task struct {\n\tID       cron.EntryID\n\tSchedule string\n\tAction   func()\n}\n\ntype Scheduler struct {\n\tcron  *cron.Cron\n\ttasks map[string]*Task\n\tmu    sync.RWMutex\n}\n\nfunc NewScheduler() *Scheduler {\n\treturn &Scheduler{\n\t\tcron:  cron.New(),\n\t\ttasks: make(map[string]*Task),\n\t}\n}\n\nfunc (s *Scheduler) Start() {\n\ts.cron.Start()\n}\n\nfunc (s *Scheduler) Stop() {\n\ts.cron.Stop()\n}\n\nfunc (s *Scheduler) AddTask(key string, schedule string, action func()) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\n\t// Remove existing task if it exists\n\tif existingTask, exists := s.tasks[key]; exists {\n\t\ts.cron.Remove(existingTask.ID)\n\t\tdelete(s.tasks, key)\n\t}\n\n\tid, err := s.cron.AddFunc(schedule, func() {\n\t\tlog.Printf(\"Running scheduled task for %s\", key)\n\t\taction()\n\t})\n\n\tif err != nil {\n\t\treturn err\n\t}\n\n\ts.tasks[key] = &Task{\n\t\tID:       id,\n\t\tSchedule: schedule,\n\t\tAction:   action,\n\t}\n\n\treturn nil\n}\n\nfunc (s *Scheduler) RemoveTask(key string) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\n\tif task, exists := s.tasks[key]; exists {\n\t\ts.cron.Remove(task.ID)\n\t\tdelete(s.tasks, key)\n\t}\n}\n\nfunc (s *Scheduler) UpdateTask(key string, schedule string, action func()) error {\n\treturn s.AddTask(key, schedule, action)\n}\n\nfunc CheckPullRequestStatus() {\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\ttoken := state.State.Settings.GitHubToken\n\tif token == \"\" {\n\t\tlog.Println(\"GitHub token not configured, skipping pull request status check\")\n\t\treturn\n\t}\n\n\tfor prNumber, pr := range state.State.TrackedPullRequests {\n\t\tparts := strings.Split(pr.IssueURL, \"/\")\n\t\tif len(parts) < 2 {\n\t\t\tlog.Printf(\"invalid issue URL format for PR %d\", prNumber)\n\t\t\tdelete(state.State.TrackedPullRequests, prNumber)\n\t\t\tcontinue\n\t\t}\n\t\towner := parts[3]\n\t\trepo := parts[4]\n\n\t\tctx := context.Background()\n\t\tclient := github.NewClient(ctx, token)\n\n\t\tghPR, _, err := client.PullRequests.Get(ctx, owner, repo, prNumber)\n\t\tif err != nil {\n\t\t\tlog.Printf(\"Error getting pull request %d: %v\", prNumber, err)\n\t\t\tdelete(state.State.TrackedPullRequests, prNumber)\n\t\t\tcontinue\n\t\t}\n\n\t\t// Check if the 'dev-team' label is still present\n\t\thasDevTeamLabel := false\n\t\tfor _, label := range ghPR.Labels {\n\t\t\tif label.GetName() == \"dev-team\" {\n\t\t\t\thasDevTeamLabel = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\n\t\t// If the PR is closed, merged, or the label is removed, remove it from tracking\n\t\tif ghPR.GetState() == \"closed\" || ghPR.GetMerged() || !hasDevTeamLabel {\n\t\t\tlog.Printf(\"Removing pull request %d from tracking (state: %s, merged: %v, dev-team label: %v)\", prNumber, ghPR.GetState(), ghPR.GetMerged(), hasDevTeamLabel)\n\t\t\tdelete(state.State.TrackedPullRequests, prNumber)\n\t\t}\n\t}\n}\n path:/internal/scheduler/scheduler.go]}"}
