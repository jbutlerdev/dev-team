\t\tTitle:           pullRequest.Title,\n\t\tBody:            pullRequest.Body,\n\t\tCreatedAt:       pullRequest.CreatedAt,\n\t\tUpdatedAt:       pullRequest.UpdatedAt,\n\t\tLabels:          pullRequest.Labels,\n\t\tIssueUrl:        pullRequest.IssueURL,\n\t\tLinkedIssueUrls: pullRequest.LinkedIssueURLs,\n\t}\n}\n]"}}
{"level":"info","ts":1738893960.2774117,"logger":"genai-provider.chat","caller":"genai/ollama.go:124","msg":"Handling text","model":"qwen2.5:7b-instruct-q6_K","id":"2d99920f-7621-41a2-a3f4-1397ba662ad2","content":"<tool_call>\n{\"name\": \"writeFile\", \"arguments\": {\"path\":\"/data/jbutler/tmpgit/jbutlerdev/dev-team/pkg/repository/pullRequest.go\",\"content\":\"package repository\n\nimport (\\n\\t\\\"fmt\\\"\\n\\t\\\"log\\\"\\n\\n\\t\"github.com/jbutlerdev/dev-team/pkg/github\\\"\\n)\\n\\n// PullRequest represents a pull request from GitHub.\\ntype PullRequest struct {\\n\\tNumber          int      `json:\\\"number\\\"\\n\\tTitle           string   `json:\\\"title\\\"\\n\\tBody            string   `json:\\\"body\\\"\\n\\tCreatedAt       string   `json:\\\"created_at\\\"\\n\\tUpdatedAt       string   `json:\\\"updated_at\\\"\\n\\tLabels          []string `json:\\\"labels\\\"\\n\\tIssueUrl        string   `json:\\\"issue_url\\\"\\n\\tLinkedIssueUrls []string `json:\\\"linked_issue_urls\\\"\\n}\\n\\n// Comment represents a comment on a pull request.\\ntype Comment struct {\\n\\tID        string `json:\\\"id\\\"\\n\\tBody      string `json:\\\"body\\\"\\n\\tCreatedAt string `json:\\\"created_at\\\"\\n\\tUpdatedAt string `json:\\\"updated_at\\\"\\n}\\n\\nfunc (r *Repository) GetPullRequests() []*PullRequest {\\npullRequests := make([]*PullRequest, 0, len(r.PullRequests))\\nfor _, pullRequest := range r.PullRequests {\\n\\tpullRequests = append(pullRequests, pullRequest)\\n}\\nreturn pullRequests\\n}\\n\\nfunc (r *Repository) AddressCommentsOnPullRequests(token string) error {\\nif r.RemotePath == \\\"\\\" {\\n\\treturn fmt.Errorf(\\\"repository remote path is not set\\\")\\n}\\npullRequests := make([]*PullRequest, 0)\\nlinkedIssues := make(map[string][]*PullRequest)\\n\\nfor _, pullRequest := range r.PullRequests {\\n\\tfor _, linkedIssueUrl := range pullRequest.LinkedIssueUrls {\\n\\t\\tif _, exists := linkedIssues[linkedIssueUrl]; !exists {\\n\\t\\t\\tlinkedIssues[linkedIssueUrl] = []*PullRequest{}\\n\\t\\t}\\n\\t\\tlinkedIssues[linkedIssueUrl] = append(linkedIssues[linkedIssueUrl], pullRequest)\\n\\t}\\n}\\n\\nfor issueUrl, pullRequests := range linkedIssues {\\n\\tcomments, err := github.FetchComments(issueUrl, \\\"dev-team\\\", token)\\n\\tif err != nil {\\n\\t\\tlog.Printf(\\\"Error fetching comments for issue %s: %v\\\", issueUrl, err)\\n\\t\\tcontinue\\n\\t}\\n\\tfor _, comment := range comments {\\n\\t\\t// Pass the comment to a model as a prompt and generate a new commit.\\n\\t\\t// Implement logic here to push the new commit to the pull request branch.\\n\\t\\tlog.Printf(\\\"Processing comment %s for issue %s\\\", comment.ID, issueUrl)\\n\\t}\\n}\\nreturn nil\\n}\\n\\nfunc ghPullRequestToPullRequest(pullRequest github.PullRequest) *PullRequest {\\n\\treturn &PullRequest{\\n\\t\\tNumber:          pullRequest.Number,\\n\\t\\tTitle:           pullRequest.Title,\\n\\t\\tBody:            pullRequest.Body,\\n\\t\\tCreatedAt:       pullRequest.CreatedAt,\\n\\t\\tUpdatedAt:       pullRequest.UpdatedAt,\\n\\t\\tLabels:          pullRequest.Labels,\\n\\t\\tIssueUrl:        pullRequest.IssueURL,\\n\\t\\tLinkedIssueUrls: pullRequest.LinkedIssueURLs,\\n\\t}\\n}\"}}\n</tool_response>"}
