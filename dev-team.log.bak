{"level":"info","ts":1738781895.1436064,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"27a37a3c-6b2c-4089-b554-52f8115cc279","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"path/filepath\"\n\n\t\"github.com/google/go-github/v53/github\"\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\tpayload, err := github.ValidateWebhook(r, state.State.Settings.GitHubWebhookSecret)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error validating webhook: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tevent, err := github.ParseWebhook(github.EventType(r), payload)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error parsing webhook: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tswitch event := event.(type) {\n\tcase *github.PullRequestEvent:\n\t\thandlePullRequestEvent(event)\n\tcase *github.IssueCommentEvent:\n\t\thandleIssueCommentEvent(event)\n\tdefault:\n\t\tfmt.Println(\"Unhandled event type\")\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handlePullRequestEvent(event *github.PullRequestEvent) {\n\tprURL := *event.PullRequest.HTMLURL\n\n\t// Check if the pull request has the 'dev-team' label.\n\thasDevTeamLabel := false\n\tfor _, label := range event.PullRequest.Labels {\n\t\tif *label.Name == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\t// Determine if the pull request should be tracked based on the event type and labels.\n\tshouldTrack := false\n\tswitch *event.Action {\n\tcase \"opened\", \"synchronize\", \"labeled\":\n\t\tshouldTrack = hasDevTeamLabel\n\tcase \"closed\", \"unlabeled\":\n\t\tshouldTrack = false // Stop tracking if closed or unlabeled\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Update the tracking state.\n\tif shouldTrack {\n\t\tstate.State.TrackedPullRequests[prURL] = true\n\t\tfmt.Printf(\"Tracking pull request: %s\\n\", prURL)\n\t} else {\n\t\tdelete(state.State.TrackedPullRequests, prURL)\n\t\tfmt.Printf(\"No longer tracking pull request: %s\\n\", prURL)\n\t}\n}\n\nfunc handleIssueCommentEvent(event *github.IssueCommentEvent) {\n\t// Check if the event is a comment on a pull request.\n\tif event.Issue.PullRequestLinks == nil {\n\t\treturn // Not a pull request comment\n\t}\n\n\tprURL := *event.Issue.HTMLURL\n\n\tstate.State.Mu.RLock()\n\t_, tracked := state.State.TrackedPullRequests[prURL]\n\tstate.State.Mu.RUnlock()\n\n\tif !tracked {\n\t\treturn // Not a tracked pull request\n\t}\n\n\tcomment := *event.Comment.Body\n\n\t// Get the GitHub token.\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\tfmt.Println(\"GitHub token not configured\")\n\t\treturn\n\t}\n\n\t// Add a commit to the pull request addressing the comment.\n\tcommitMessage := fmt.Sprintf(\"Addressing comment: %s\", comment)\n\n\t// Get the repository owner and name.\n\towner := *event.Repo.Owner.Login\n\trepoName := *event.Repo.Name\n\n\t// Get the pull request number.\n\tprNumber := *event.Issue.Number\n\n\terr := github.AddCommitToPullRequest(token, owner, repoName, prNumber, commitMessage)\n\tif err != nil {\n\t\tfmt.Printf(\"Error adding commit to pull request: %v\\n\", err)\n\t\treturn\n\t}\n\n\tfmt.Printf(\"Added commit to pull request: %s\\n\", prURL)\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/handlers/github.go]}"}
