 \"github.com/google/go-github/v60/github\".Tree\npkg/github/github.go:328:70: not enough arguments in call to client.Git.CreateCommit\n\thave (\"context\".Context, string, string, *\"github.com/google/go-github/v60/github\".Commit)\n\twant (\"context\".Context, string, string, *\"github.com/google/go-github/v60/github\".Commit, *\"github.com/google/go-github/v60/github\".CreateCommitOptions)) (typecheck)\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t^\ninternal/handlers/github.go:10:2: other declaration of github (typecheck)\n\t\"github.com/google/go-github/v53/github\"\n\t^\ninternal/handlers/github.go:21:23: undefined: github.FetchRepositories (typecheck)\n\trepos, err := github.FetchRepositories(token)\n\t                     ^\ninternal/handlers/github.go:83:25: undefined: github.ValidateWebhook (typecheck)\n\tpayload, err := github.ValidateWebhook(r, state.State.Settings.GitHubWebhookSecret)\n\t                       ^\ninternal/handlers/github.go:171:17: undefined: github.AddCommitToPullRequest (typecheck)\n\t\terr := github.AddCommitToPullRequest(token, owner, repo, pullRequestNumber, commitMessage, content, path, branch)\n\t\t              ^\n"}
