turn err\n\t}\n\n\towner, name := splitRepoName(repoName)\n\n\t// Get the pull request.\n\tpr, _, err := client.PullRequests.Get(ctx, owner, name, prNumber)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting pull request: %w\", err)\n\t}\n\n\t// Get the reference for the base branch.\n\tbaseBranch := pr.GetBase().GetRef()\n\n\tref, _, err := client.Git.GetRef(ctx, owner, name, \"refs/heads/\"+baseBranch)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting base branch reference: %w\", err)\n\t}\n\n\t// Get the commit for the base branch.\n\tcommit, _, err := client.Git.GetCommit(ctx, owner, name, ref.GetObject().GetSHA())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting base branch commit: %w\", err)\n\t}\n\n\t// Create a new tree with the changes.\n\n\t// For now, we'll create an empty tree\n\temptyTree, _, err := client.Git.CreateTree(ctx, owner, name, github.NewTree{}) \n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating tree: %w\", err)\n\t}\n\n\n\t// Create the commit, with the current commit as the parent.\n\tcommitParams := &github.Commit{\n\t\tMessage: &commitMessage,\n\t\tTree:    emptyTree.SHA,\n\t\tParents: []*github.Commit{\n\t\t\t{\n\t\t\t\tSHA: commit.SHA,\n\t\t\t},\n\t\t},\n\t}\n\n\n\n\tnewCommit, _, err := client.Git.CreateCommit(ctx, owner, name, commitParams)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating commit: %w\", err)\n\t}\n\n\t// Update the reference for the pull request to point to the new commit.\n\n\trefParams := &github.Reference{\n\t\tRef:    github.String(\"refs/heads/\" + baseBranch),\n\t\tObject: &github.GitObject{\n\t\t\tType: github.String(\"commit\"),\n\t\t\tSHA:  newCommit.SHA,\n\t\t},\n\t}\n\n\t_, _, err = client.Git.UpdateRef(ctx, owner, name, refParams, false)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error updating reference: %w\", err)\n\t}\n\n\treturn nil\n}\n\nfunc splitRepoName(repoName string) (string, string) {\n\tsplit :=  []rune(repoName)\n\tidx := 0\n\tfor i := len(split)-1; i>=0; i--{\n\t\tif split[i] == '/'{idx = i; break;}\n\t}\n\towner := string(split[0:idx])\n\tname := string(split[idx+1:])\n\treturn owner, name\n} path:/data/jbutler/tmpgit/jbutlerdev/dev-team/pkg/github/github.go]}"}
