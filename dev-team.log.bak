{"level":"info","ts":1738787086.6231606,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"dedd28f3-918e-4be0-9bb2-ac288ab577d4","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package github\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"log\"\n\t\"net/http\"\n\t\"os\"\n\n\t\"github.com/google/go-github/v53/github\"\n\t\"golang.org/x/oauth2\"\n)\n\n// ValidateWebhook validates the signature of the incoming webhook request\nfunc ValidateWebhook(r *http.Request) ([]byte, error) {\n\tsecret := os.Getenv(\"GITHUB_WEBHOOK_SECRET\")\n\tif secret == \"\" {\n\t\tlog.Println(\"GITHUB_WEBHOOK_SECRET not set\")\n\t\treturn nil, fmt.Errorf(\"GITHUB_WEBHOOK_SECRET not set\")\n\t}\n\n\tpayload, err := github.ValidatePayload(r, []byte(secret))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn payload, nil\n}\n\n// FetchRepositories fetches the repositories for the given GitHub token\nfunc FetchRepositories(token string) ([]*github.Repository, error) {\n\tctx := context.Background()\n\tsource := oauth2.StaticTokenSource(\n\t\t&oauth2.Token{\n\t\t\tAccessToken: token,\n\t\t},\n\t)\n\thttpClient := oauth2.NewClient(ctx, source)\n\n\tclient := github.NewClient(httpClient)\n\n\tif client == nil {\n\t\treturn nil, fmt.Errorf(\"error creating github client\")\n\t}\n\n\trepos, _, err := client.Repositories.List(ctx, \"\", nil)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn repos, nil\n}\n\nfunc AddCommitToPullRequest(token string, repoName string, prNumber int, commitMessage string) error {\n\tctx := context.Background()\n\tsource := oauth2.StaticTokenSource(\n\t\t&oauth2.Token{\n\t\t\tAccessToken: token,\n\t\t},\n\t)\n\thttpClient := oauth2.NewClient(ctx, source)\n\n\tclient := github.NewClient(httpClient)\n\n\tif client == nil {\n\t\treturn fmt.Errorf(\"error creating github client\")\n\t}\n\n\towner, name := splitRepoName(repoName)\n\n\t// Get the pull request.\n\tpr, _, err := client.PullRequests.Get(ctx, owner, name, prNumber)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting pull request: %w\", err)\n\t}\n\n\t// Get the reference for the base branch.\n\tbaseBranch := pr.GetBase().GetRef()\n\n\tref, _, err := client.Git.GetRef(ctx, owner, name, \"refs/heads/\"+baseBranch)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting base branch reference: %w\", err)\n\t}\n\n\t// Get the commit for the base branch.\n\tcommit, _, err := client.Git.GetCommit(ctx, owner, name, ref.GetObject().GetSHA())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting base branch commit: %w\", err)\n\t}\n\n\t// Create a new tree with the changes.\n\temptyTreeEntries := []*github.TreeEntry{}\n\temptyTree, _, err := client.Git.CreateTree(ctx, owner, name, *commit.SHA, emptyTreeEntries)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating tree: %w\", err)\n\t}\n\n\t// Create the commit, with the current commit as the parent.\n\tcommitParams := &github.Commit{\n\t\tMessage: &commitMessage,\n\t\tTree:    emptyTree.SHA,\n\t\tParents: []*github.Commit{\n\t\t\t{\n\t\t\t\tSHA: commit.SHA,\n\t\t\t},\n\t\t},\n\t}\n\n\tnewCommit, _, err := client.Git.CreateCommit(ctx, owner, name, commitParams)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating commit: %w\", err)\n\t}\n\n\t// Update the reference for the pull request to point to the new commit.\n\n\trefParams := &github.Reference{\n\t\tRef:    github.String(\"refs/heads/\" + baseBranch),\n\t\tObject: &github.GitObject{\n\t\t\tType: github.String(\"commit\"),\n\t\t\tSHA:  newCommit.SHA,\n\t\t},\n\t}\n\n\t_, _, err = client.Git.UpdateRef(ctx, owner, name, refParams, false)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error updating reference: %w\", err)\n\t}\n\n\treturn nil\n}\n\nfunc splitRepoName(repoName string) (string, string) {\n\tsplit := []rune(repoName)\n\tidx := 0\n\tfor i := len(split) - 1; i >= 0; i-- {\n\t\tif split[i] == '/' {\n\t\t\tidx = i\n\t\t\tbreak\n\t\t}\n\t}\n\towner := string(split[:idx])\n\tname := string(split[idx+1:])\n\treturn owner, name\n} path:/data/jbutler/tmpgit/jbutlerdev/dev-team/pkg/github/github.go]}"}
