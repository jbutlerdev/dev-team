{"level":"info","ts":1738780826.494731,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"b880db19-ea1b-465a-acee-1ce7fc22b40a","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"path/filepath\"\n\n\t\"github.com/google/go-github/v53/github\"\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\tpayload, err := github.ValidatePayload(r, []byte(state.State.Settings.GitHubWebhookSecret))\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tevent, err := github.ParseWebHook(github.WebHookType(r), payload)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tswitch event := event.(type) {\n\tcase *github.PullRequestEvent:\n\t\thandlePullRequestEvent(event)\n\tcase *github.IssueCommentEvent:\n\t\thandleIssueCommentEvent(event)\n\tdefault:\n\t\tfmt.Println(\"Unhandled event type\")\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handlePullRequestEvent(event *github.PullRequestEvent) {\n\tpr := event.PullRequest\n\trepoOwner := event.Repo.Owner.GetLogin()\n\trepoName := event.Repo.GetName()\n\tprNumber := pr.GetNumber()\n\tprID := fmt.Sprintf(\"%s/%s/%d\", repoOwner, repoName, prNumber)\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Check if the pull request has the 'dev-team' label.\n\thasDevTeamLabel := false\n\tfor _, label := range pr.Labels {\n\t\tif label.GetName() == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\t// Handle pull request opening or labeling with 'dev-team'.\n\tif event.GetAction() == \"opened\" || (event.GetAction() == \"labeled\" && hasDevTeamLabel) {\n\t\tif hasDevTeamLabel {\n\t\t\t// Add the pull request to the tracked pull requests.\n\t\t\tstate.State.TrackedPullRequests[prID] = state.TrackedPullRequest{\n\t\t\t\tRepositoryOwner: repoOwner,\n\t\t\t\tRepositoryName:  repoName,\n\t\t\t\tPullRequestNumber: prNumber,\n\t\t\t\tLastCommentProcessed: \"\", // Initialize with an empty string\n\t\t\t}\n\t\t\tfmt.Printf(\"Tracking pull request %s\\n\", prID)\n\t\t}\n\t}\n\n\t// Handle pull request closing, merging, or unlabeling.\n\tif event.GetAction() == \"closed\" || event.GetAction() == \"unlabeled\" {\n\t\tif _, tracked := state.State.TrackedPullRequests[prID]; tracked {\n\t\t\t// If the pull request was closed or unlabeled, remove it from tracked pull requests.\n\t\t\tdelete(state.State.TrackedPullRequests, prID)\n\t\t\tfmt.Printf(\"No longer tracking pull request %s\\n\", prID)\n\t\t}\n\t}\n}\n\nfunc handleIssueCommentEvent(event *github.IssueCommentEvent) {\n\tissue := event.Issue\n\tcomment := event.Comment\n\n\tif issue.PullRequestLinks == nil {\n\t\treturn // It's not a pull request comment\n\t}\n\n\trepoOwner := event.Repo.Owner.GetLogin()\n\trepoName := event.Repo.GetName()\n\tprNumber := issue.GetNumber()\n\tcommentID := comment.GetID()\n\tprID := fmt.Sprintf(\"%s/%s/%d\", repoOwner, repoName, prNumber)\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\ttrackedPR, tracked := state.State.TrackedPullRequests[prID]\n\tif !tracked {\n\t\treturn // Not a tracked pull request\n\t}\n\n\t// Check if the comment has already been processed\n\tif comment.GetID() <= int64(trackedPR.LastCommentProcessed) {\n\t\tfmt.Println(\"Comment already processed\")\n\t\treturn\n\t}\n\n\ttoken := state.State.Settings.GitHubToken\n\tif token == \"\" {\n\t\tfmt.Println(\"GitHub token not configured\")\n\t\treturn\n\t}\n\n\tcommitMessage := fmt.Sprintf(\"Address comment: %s\", comment.GetBody())\n\tcontent := \"This commit addresses the comment.\"\n\n\terr := github.AddCommitToPullRequest(token, repoOwner, repoName, prNumber, commitMessage, content)\n\tif err != nil {\n\t\tfmt.Printf(\"Error adding commit to pull request: %v\\n\", err)\n\t\treturn\n\t}\n\n\t// Update the last processed comment ID\n\ttrackedPR.LastCommentProcessed = string(commentID)\n\tstate.State.TrackedPullRequests[prID] = trackedPR\n\n\tfmt.Printf(\"Added commit to pull request %s in response to comment %d\\n\", prID, commentID)\n}\n path:internal/handlers/github.go]}"}
