{"level":"info","ts":1738784472.800413,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"3e9135bd-a44b-47df-8439-6853c783528a","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package config\n\nimport (\n\t\"encoding/json\"\n\t\"log\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/scheduler\"\n\t\"github.com/jbutlerdev/dev-team/internal/settings\"\n)\n\nconst ConfigPath = \".config/dev-team/config.json\"\n\n// AppState struct { // Removing state for now to break the cycle\n// \tRepositories map[string]*repository.Repository\n// \tSettings     settings.Settings\n// \tScheduler    *scheduler.Scheduler\n// }\n\n\nfunc LoadConfig(path string) (map[string]*Repository, *settings.Settings, *scheduler.Scheduler, error) {\n\tdata, err := os.ReadFile(path)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\t// Create default state if config doesn't exist\n\t\t\t//appState := &state.AppState{\n\t\t\t//\tRepositories: make(map[string]*repository.Repository),\n\t\t\tsettingsData := &settings.Settings{\n\t\t\t\tProvider: \"gemini\",\n\t\t\t//\t},\n\t\t\t}\n\t\t\tschedulerData := scheduler.NewScheduler()\n\t\t\t//Scheduler: scheduler.NewScheduler(),\n\t\t\t//}\n\t\t\t//state.State = appState\n\t\t\treturn make(map[string]*Repository), settingsData, schedulerData, SaveConfig(make(map[string]*Repository), settingsData, path) //Returning default values\n\t\t}\n\t\treturn nil, nil, nil, err\n\t}\n\n\tvar config struct {\n\t\tRepositories map[string]Repository `json:\"repositories\"`\n\t\tSettings     settings.Settings                `json:\"settings\"`\n\t}\n\tif err := json.Unmarshal(data, &config); err != nil {\n\t\treturn nil, nil, nil, err\n\t}\n\n\t// Create state from config\n\t//appState := &state.AppState{\n\t\t//Repositories: make(map[string]*repository.Repository),\n\t\t//Settings:     config.Settings,\n\t\t//Scheduler:    scheduler.NewScheduler(),\n\t//}\n\nschedulerData := scheduler.NewScheduler()\n\n\trepositories := make(map[string]*Repository)\nsettingsData := &config.Settings\n\n\t// Set up repositories and their schedules\n\tfor path, repo := range config.Repositories {\n\t\tr := NewRepository(repo.Path)\n\t\tr.Schedule = repo.Schedule\n\t\tr.RemotePath = repo.RemotePath\n\t\terr := r.UpdateStatus()\n\t\tif err != nil {\n\t\t\tlog.Printf(\"Error getting repo status: %v\", err)\n\t\t}\n\t\t//appState.Repositories[path] = r\n\t\trepositories[path] = r\n\t\terr = schedulerData.AddTask(path, repo.Schedule, func() {\n\t\t\terr := r.Sync(\"\", settingsData.GitHubToken) //Removed state.State.GenAI\n\t\t\tif err != nil {\n\t\t\t\tlog.Printf(\"Error syncing repo: %v\", err)\n\t\t\t}\n\t\t\t//appState.Mu.Lock()\n\t\t\t//appState.Repositories[path] = r\n\t\t\t//appState.Mu.Unlock()\n\t\t\t//appState.Repositories[path] = r\n\t\t\trepositories[path] = r\n\t\t})\n\t\tif err != nil {\n\t\t\tlog.Printf(\"Error setting up schedule for %s: %v\", path, err)\n\t\t}\n\t}\n\n\t//return appState, nil\n\treturn repositories, settingsData, schedulerData, nil\n}\n\nfunc SaveConfig(repositories map[string]*Repository, settingsData *settings.Settings, path string) error {\n\tif err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {\n\t\treturn err\n\t}\n\n\t// Create config from state\n\tconfig := struct {\n\t\tRepositories map[string]Repository `json:\"repositories\"`\n\t\tSettings     settings.Settings                `json:\"settings\"`\n\t}{\n\t\tRepositories: make(map[string]Repository),\n\t\tSettings:     *settingsData,\n\t}\n\n\tfor path, repo := range repositories {\n\t\tconfig.Repositories[path] = *repo\n\t}\n\n\tdata, err := json.MarshalIndent(config, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\n\treturn os.WriteFile(path, data, 0644)\n}\n\ntype Repository struct {\n\tPath         string               `json:\"path\"`\n\tSchedule     string               `json:\"schedule\"`\n\tLastSync     time.Time            `json:\"lastSync\"`\n\tState        *Status              `json:\"status,omitempty\"`\n\tIssues       map[int]*Issue       `json:\"issues,omitempty\"`\n\tPullRequests map[int]*PullRequest `json:\"pullRequests,omitempty\"`\n\tRemotePath   string               `json:\"remotePath,omitempty\"`\n}\n\n\ntype Issue struct {\n\tID        int\n\tTitle     string\n\tBody      string\n\tSourceURL string\n}\n\n// PullRequest represents a GitHub pull request.\ntype PullRequest struct {\n\tID        int\n\tTitle     string\n\tBody      string\n\tSourceURL string\n}\n\n\ntype Status struct {\n\tHasChanges    bool\n\tCurrentBranch string\n}\n\n\nfunc NewRepository(path string) *Repository {\n\treturn &Repository{\n\t\tPath:         path,\n\t\tIssues:       make(map[int]*Issue),\n\t\tPullRequests: make(map[int]*PullRequest),\n\t}\n}\n path:/internal/config/config.go]}"}
