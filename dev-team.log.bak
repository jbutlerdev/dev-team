{"level":"info","ts":1738786520.345307,"logger":"genai-provider.chat","caller":"genai/gemini.go:78","msg":"Handling text","model":"models/gemini-2.0-flash-exp","id":"0e8b7532-e326-4943-84b2-3cf914eedb3d","content":"Alright, I've reviewed `internal/handlers/github.go`. It currently handles fetching repositories and issues. I need to add a handler for webhook events to track pull requests. I'll also need to modify the `state` package to store the tracked pull requests.\n\nHere's the updated plan:\n\n1.  **Modify `internal/handlers/github.go`:** Add a new handler function (e.g., `HandleGitHubWebhook`) to receive and process webhook events. This handler will:\n    *   Check if the event is a pull request event.\n    *   Check if the pull request has the `dev-team` label.\n    *   If so, add the pull request to the tracked pull requests in the `state`.\n    *   If the pull request is closed, merged, or the `dev-team` label is removed, remove it from the tracked pull requests.\n    *   If a comment is added to a tracked pull request, trigger a new commit.\n2.  **Modify `internal/state/state.go`:** Add a field to the `State` struct to store the tracked pull requests (e.g., `TrackedPullRequests map[string]bool`).  Also, add methods to add, remove, and check if a pull request is being tracked. The key of the map will be the repository name + pull request number.\n3.  **Modify `pkg/github/github.go`:** Add a function to add a commit to a pull request.\n4.  **Update other files as needed:**  Make any necessary adjustments to other files to integrate the changes.\n\nLet's start by modifying `internal/handlers/github.go`.\n\n"}
{"level":"info","ts":1738786520.3453245,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"0e8b7532-e326-4943-84b2-3cf914eedb3d","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"path/filepath\"\n\n\t\"github.com/google/go-github/v57/github\"\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\tpayload, err := github.ValidateWebhook(r, state.State.Settings.GitHubWebhookSecret)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\teventType := r.Header.Get(\"X-GitHub-Event\")\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\tvar pl github.PullRequestEvent\n\t\terr = json.Unmarshal(payload, &pl)\n\t\tif err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\thandlePullRequestEvent(pl)\n\tcase \"issue_comment\":\n\t\tvar ic github.IssueCommentEvent\n\t\terr = json.Unmarshal(payload, &ic)\n\t\tif err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\thandleIssueCommentEvent(ic)\n\tdefault:\n\t\tfmt.Println(\"Ignoring event type\", eventType)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handlePullRequestEvent(pl github.PullRequestEvent) {\n\trepoName := pl.GetRepo().GetFullName()\n\tprNumber := pl.GetPullRequest().GetNumber()\n\tprKey := fmt.Sprintf(\"%s#%d\", repoName, prNumber)\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Check if the PR has the 'dev-team' label.\n\thasDevTeamLabel := false\n\tfor _, label := range pl.GetPullRequest().Labels {\n\t\tif label.GetName() == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\t// Determine the action and update the tracked PRs accordingly.\n\taction := pl.GetAction()\n\tswitch action {\n\tcase \"opened\", \"reopened\", \"labeled\", \"synchronize\":\n\t\tif hasDevTeamLabel {\n\t\t\tstate.State.TrackedPullRequests[prKey] = true\n\t\t\tfmt.Println(\"Tracking pull request\", prKey)\n\t\t}\n\tcase \"closed\", \"merged\", \"unlabeled\":\n\t\t// If the PR was closed, merged, or the 'dev-team' label was removed,\n\t\t// remove it from the tracked PRs.\n\t\tif _, ok := state.State.TrackedPullRequests[prKey]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, prKey)\n\t\t\tfmt.Println(\"Stopped tracking pull request\", prKey)\n\t\t}\n\t}\n}\n\nfunc handleIssueCommentEvent(ic github.IssueCommentEvent) {\n\t// Only process comments on pull requests.\n\tif ic.GetIssue().PullRequestLinks == nil {\n\t\treturn\n\t}\n\n\trepoName := ic.GetRepo().GetFullName()\n\tissueNumber := ic.GetIssue().GetNumber()\n\tprKey := fmt.Sprintf(\"%s#%d\", repoName, issueNumber)\n\n\tstate.State.Mu.RLock()\n\t_, tracked := state.State.TrackedPullRequests[prKey]\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif tracked {\n\t\tcommentBody := ic.GetComment().GetBody()\n\t\t// Add a commit to the pull request addressing the comment.\n\t\terr := github.AddCommitToPullRequest(token, repoName, issueNumber, commentBody)\n\t\tif err != nil {\n\t\t\tfmt.Println(\"Error adding commit to pull request:\", err)\n\t\t}\n\t}\n}\n path:internal/handlers/github.go]}"}
