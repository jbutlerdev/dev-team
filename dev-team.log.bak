{"level":"info","ts":1738781427.3022583,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"2e4f7289-7789-4dac-a1ab-0d2406451e54","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"context\"\n\t\"crypto/hmac\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"log\"\n\t\"net/http\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\t// Verify the webhook signature\n\tsecret := state.State.Settings.GitHubWebhookSecret\n\tif secret == \"\" {\n\t\thttp.Error(w, \"GitHub webhook secret not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tpayload, err := io.ReadAll(r.Body)\n\tif err != nil {\n\t\thttp.Error(w, \"Error reading request body\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tsignature := r.Header.Get(\"X-Hub-Signature-256\")\n\tif signature == \"\" {\n\t\thttp.Error(w, \"Missing X-Hub-Signature-256 header\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tif !verifySignature(payload, signature, secret) {\n\t\thttp.Error(w, \"Invalid signature\", http.StatusUnauthorized)\n\t\treturn\n\t}\n\n\t// Parse the webhook payload\n\tvar event map[string]interface{}\n\tif err := json.Unmarshal(payload, &event); err != nil {\n\t\thttp.Error(w, \"Error parsing JSON payload\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Determine the event type\n\teventType := r.Header.Get(\"X-GitHub-Event\")\n\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\thandlePullRequestEvent(event)\n\tcase \"issue_comment\":\n\t\thandleIssueCommentEvent(event)\n\tcase \"issues\":\n\t\thandleIssueEvent(event)\n\tdefault:\n\t\tlog.Printf(\"Unhandled event type: %s\", eventType)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc verifySignature(payload []byte, signature string, secret string) bool {\n\tsigParts := strings.SplitN(signature, \"=\", 2)\n\tif len(sigParts) != 2 || sigParts[0] != \"sha256\" {\n\t\treturn false\n\t}\n\n\thash := hmac.New(sha256.New, []byte(secret))\n\thash.Write(payload)\n\texpectedSignature := hex.EncodeToString(hash.Sum(nil))\n\n\treturn hmac.Equal([]byte(sigParts[1]), []byte(expectedSignature))\n}\n\nfunc handlePullRequestEvent(event map[string]interface{}) {\n\taction := event[\"action\"].(string)\n\tpr := event[\"pull_request\"].(map[string]interface{})\n\tlabels := pr[\"labels\"].([]interface{})\n\tnumber := int(pr[\"number\"].(float64))\n\trepoData := event[\"repository\"].(map[string]interface{})\n\trepoName := repoData[\"name\"].(string)\n\townerData := repoData[\"owner\"].(map[string]interface{})\n\townerName := ownerData[\"login\"].(string)\n\tfullName := ownerName + \"/\" + repoName\n\n\tisDevTeam := false\n\tfor _, label := range labels {\n\t\tlabelMap := label.(map[string]interface{})\n\t\tname := labelMap[\"name\"].(string)\n\t\tif name == \"dev-team\" {\n\t\t\tisDevTeam = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\tprKey := fmt.Sprintf(\"%s#%d\", fullName, number)\n\n\tswitch action {\n\tcase \"opened\", \"reopened\", \"labeled\", \"synchronize\":\n\t\tif isDevTeam {\n\t\t\tstate.State.Mu.Lock()\n\t\t\tif state.State.TrackedPRs == nil {\n\t\t\t\tstate.State.TrackedPRs = make(map[string]bool)\n\t\t\t}\n\t\t\tstate.State.TrackedPRs[prKey] = true\n\t\t\tstate.State.Mu.Unlock()\n\t\t\tlog.Printf(\"Tracking pull request: %s\", prKey)\n\t\t}\n\tcase \"closed\", \"unlabeled\":\n\t\tif !isDevTeam {\n\t\t\tstate.State.Mu.Lock()\n\t\t\tdelete(state.State.TrackedPRs, prKey)\n\t\t\tstate.State.Mu.Unlock()\n\t\t\tlog.Printf(\"No longer tracking pull request: %s\", prKey)\n\t\t}\n\t}\n}\n\nfunc handleIssueCommentEvent(event map[string]interface{}) {\n\tissue := event[\"issue\"].(map[string]interface{})\n\tnumber := int(issue[\"number\"].(float64))\n\trepoData := event[\"repository\"].(map[string]interface{})\n\trepoName := repoData[\"name\"].(string)\n\townerData := repoData[\"owner\"].(map[string]interface{})\n\townerName := ownerData[\"login\"].(string