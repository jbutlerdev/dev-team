quest.Body,\n\t\tCreatedAt:       pullRequest.CreatedAt,\n\t\tUpdatedAt:       pullRequest.UpdatedAt,\n\t\tLabels:          pullRequest.Labels,\n\t\tIssueUrl:        pullRequest.IssueURL,\n\t\tLinkedIssueUrls: pullRequest.LinkedIssueURLs,\n\t}\n}\n","path":"pkg/repository/pullRequest.go"}}
