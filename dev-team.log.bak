n\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\tsecret := state.State.Settings.GitHubWebhookSecret\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tpayload, err := internalgithub.ValidateWebhook(r, secret)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\teventType := r.Header.Get(\"X-GitHub-Event\")\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\tvar pl github.PullRequestEvent\n\t\terr = json.Unmarshal(payload, &pl)\n\t\tif err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\thandlePullRequestEvent(pl)\n\tcase \"issue_comment\":\n\t\tvar ic github.IssueCommentEvent\n\t\terr = json.Unmarshal(payload, &ic)\n\t\tif err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\thandleIssueCommentEvent(ic, token)\n\tdefault:\n\t\tfmt.Println(\"Ignoring event type\", eventType)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handlePullRequestEvent(pl github.PullRequestEvent) {\n\trepoName := pl.GetRepo().GetFullName()\n\tprNumber := pl.GetPullRequest().GetNumber()\n\tprKey := fmt.Sprintf(\"%s#%d\", repoName, prNumber)\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Check if the PR has the 'dev-team' label.\n\thasDevTeamLabel := false\n\tfor _, label := range pl.GetPullRequest().Labels {\n\t\tif label.GetName() == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\t// Determine the action and update the tracked PRs accordingly.\n\taction := pl.GetAction()\n\tswitch action {\n\tcase \"opened\", \"reopened\", \"labeled\", \"synchronize\":\n\t\tif hasDevTeamLabel {\n\t\t\tstate.State.TrackedPullRequests[prKey] = true\n\t\t\tfmt.Println(\"Tracking pull request\", prKey)\n\t\t}\n\tcase \"closed\", \"merged\", \"unlabeled\":\n\t\t// If the PR was closed, merged, or the 'dev-team' label was removed,\n\t\t// remove it from the tracked PRs.\n\t\tif _, ok := state.State.TrackedPullRequests[prKey]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, prKey)\n\t\t\tfmt.Println(\"Stopped tracking pull request\", prKey)\n\t\t}\n\t}\n}\n\nfunc handleIssueCommentEvent(ic github.IssueCommentEvent, token string) {\n\t// Only process comments on pull requests.\n\tif ic.GetIssue().PullRequestLinks == nil {\n\t\treturn\n\t}\n\n\trepoName := ic.GetRepo().GetFullName()\n\tissueNumber := ic.GetIssue().GetNumber()\n\tprKey := fmt.Sprintf(\"%s#%d\", repoName, issueNumber)\n\n\tstate.State.Mu.RLock()\n\t_, tracked := state.State.TrackedPullRequests[prKey]\n\tstate.State.Mu.RUnlock()\n\n\tif tracked {\n\t\tcommentBody := ic.GetComment().GetBody()\n\t\t// Add a commit to the pull request addressing the comment.\n\t\terr := internalgithub.AddCommitToPullRequest(token, repoName, issueNumber, commentBody)\n\t\tif err != nil {\n\t\t\tfmt.Println(\"Error adding commit to pull request:\", err)\n\t\t}\n\t}\n}\n","path":"internal/handlers/github.go"}}
