r:          pullRequest.Number,\n\t\tTitle:           pullRequest.Title,\n\t\tBody:            pullRequest.Body,\n\t\tCreatedAt:       pullRequest.CreatedAt,\n\t\tUpdatedAt:       pullRequest.UpdatedAt,\n\t\tLabels:          pullRequest.Labels,\n\t\tIssueUrl:        \"\", // These are not available in the github.PullRequest struct\n\t\tLinkedIssueUrls: []string{}, // These are not available in the github.PullRequest struct\n\t}\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/pkg/repository/pullRequest.go]}"}
