{"level":"info","ts":1738784401.064581,"logger":"genai-provider","caller":"genai/provider.go:105","msg":"Tool result","result":{"Name":"readFile","Response":{"content":"package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"path/filepath\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubPullRequest(w http.ResponseWriter, r *http.Request) {\n\tvar payload map[string]interface{}\n\terr := json.NewDecoder(r.Body).Decode(&payload)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding request body: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\taction, ok := payload[\"action\"].(string)\n\tif !ok {\n\t\thttp.Error(w, \"Missing or invalid 'action' field\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tpr, ok := payload[\"pull_request\"].(map[string]interface{})\n\tif !ok {\n\t\thttp.Error(w, \"Missing or invalid 'pull_request' field\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tnumber, ok := pr[\"number\"].(float64)\n\tif !ok {\n\t\thttp.Error(w, \"Missing or invalid 'pull_request.number' field\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Check if the PR has the 'dev-team' label\n\tlabels, ok := pr[\"labels\"].([]interface{})\n\tif !ok {\n\t\t// If no labels are present, treat it as if it doesn't have the 'dev-team' label\n\t\tlabels = []interface{}{}\n\t}\n\n\thasDevTeamLabel := false\n\tfor _, label := range labels {\n\t\tlabelMap, ok := label.(map[string]interface{})\n\t\tif ok {\n\t\t\tname, ok := labelMap[\"name\"].(string)\n\t\t\tif ok && name == \"dev-team\" {\n\t\t\t\thasDevTeamLabel = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\tswitch action {\n\tcase \"opened\", \"synchronize\", \"labeled\":\n\t\tif hasDevTeamLabel {\n\t\t\tstate.State.TrackPullRequest(int(number))\n\t\t}\n\tcase \"closed\", \"merged\", \"unlabeled\":\n\t\t// If the action is 'closed', 'merged', or 'unlabeled', remove the PR from the tracked PRs\n\t\tif !hasDevTeamLabel {\n\t\t\tstate.State.UntrackPullRequest(int(number))\n\t\t}\n\tcase \"created\":\n\t\tcomment, ok := payload[\"comment\"].(map[string]interface{})\n\t\tif !ok {\n\t\t\thttp.Error(w, \"Missing or invalid 'comment' field\", http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\n\t\tbody, ok := comment[\"body\"].(string)\n\t\tif !ok {\n\t\t\thttp.Error(w, \"Missing or invalid 'comment.body' field\", http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\tif state.State.IsPullRequestTracked(int(number)) {\n\t\t\t// Add a commit to the pull request that addresses the comment\n\t\t\ttoken := state.State.Settings.GitHubToken\n\t\t\t// Assuming you have the repository information available in the state\n\t\t\trepoOwner := \"jbutlerdev\" // Replace with the actual owner\n\t\t\trepoName := \"dev-team\"    // Replace with the actual repository name\n\n\t\t\terr = github.AddCommitToPullRequest(token, repoOwner, repoName, int(number), body)\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, fmt.Sprintf(\"Error adding commit to pull request: %v\", err), http.StatusInternalServerError)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n"}}}
