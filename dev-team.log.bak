{"level":"info","ts":1738786661.9412699,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"0e8b7532-e326-4943-84b2-3cf914eedb3d","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package config\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\nfunc TestLoadConfig(t *testing.T) {\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to get user home dir: %v\", err)\n\t}\n\n\tconfigPath := filepath.Join(homeDir, \".config\", \"dev-team\", \"test_config.json\")\n\n\t// Clean up config file after test\n\tdefer os.Remove(configPath)\n\n\tappState, err := LoadConfig(configPath)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to load config: %v\", err)\n\t}\n\n\tif appState.APIKey == \"\" {\n\t\tt.Error(\"API key should not be empty\")\n\t}\n}\n\nfunc TestSaveConfig(t *testing.T) {\n\thomeDir, err := os.UserHomeDir()\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to get user home dir: %v\", err)\n\t}\n\n\tconfigPath := filepath.Join(homeDir, \".config\", \"dev-team\", \"test_config.json\")\n\n\t// Clean up config file after test\n\tdefer os.Remove(configPath)\n\n\tsettings := Settings{\n\t\tProvider:          \"gemini\",\n\t\tAPIKey:            \"test_api_key\",\n\t\tGitHubToken:       \"test_github_token\",\n\t\tGitHubWebhookSecret: \"test_webhook_secret\",\n\t}\n\n\terr = SaveConfig(configPath, settings)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to save config: %v\", err)\n\t}\n\n\tloadedSettings, err := LoadConfig(configPath)\n\tif err != nil {\n\t\tt.Fatalf(\"Failed to load config after saving: %v\", err)\n\t}\n\n\tif loadedSettings.APIKey != \"test_api_key\" {\n\t\tt.Errorf(\"Expected API key 'test_api_key', got '%s'\", loadedSettings.APIKey)\n\t}\n}\n path:internal/config/config_test.go]}"}
