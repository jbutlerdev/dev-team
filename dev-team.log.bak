{"level":"info","ts":1738787093.9277945,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"dedd28f3-918e-4be0-9bb2-ac288ab577d4","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/google/go-github/v53/github\"\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\tsecret := os.Getenv(\"GITHUB_WEBHOOK_SECRET\")\n\tif secret == \"\" {\n\t\thttp.Error(w, \"GITHUB_WEBHOOK_SECRET not set\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tpayload, err := github.ValidatePayload(r, []byte(secret))\n\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error validating webhook: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\neventType := r.Header.Get(\"X-GitHub-Event\")\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\thandlePullRequestEvent(payload)\n\tcase \"issue_comment\":\n\t\thandleIssueCommentEvent(payload)\n\tdefault:\n\t\tfmt.Println(\"Unhandled event type: %s\", eventType)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handlePullRequestEvent(payload []byte) {\n\tvar event github.PullRequestEvent\n\tif err := json.Unmarshal(payload, &event); err != nil {\n\t\tfmt.Printf(\"Error unmarshaling pull request event: %v\", err)\n\t\treturn\n\t}\n\n\tpr := event.GetPullRequest()\n\tif pr == nil {\n\t\tfmt.Println(\"Pull request is nil\")\n\t\treturn\n\t}\n\n\t// Check if the pull request has the 'dev-team' label.\n\thasDevTeamLabel := false\n\tfor _, label := range pr.Labels {\n\t\tif label.GetName() == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\trepoName := event.GetRepo().GetFullName()\n\tprNumber := pr.GetNumber()\n\n\tif hasDevTeamLabel {\n\t\t// Track the pull request.\n\t\tstate.State.TrackPullRequest(repoName, prNumber)\n\t} else {\n\t\t// Untrack the pull request if it was previously tracked.\n\t\tstate.State.UntrackPullRequest(repoName, prNumber)\n\t\treturn\n\t}\n\n\t// Check if the pull request was closed or merged.\n\tif event.GetAction() == \"closed\" || event.GetPullRequest().GetMerged() {\n\t\t// Untrack the pull request.\n\t\tstate.State.UntrackPullRequest(repoName, prNumber)\n\t}\n}\n\nfunc handleIssueCommentEvent(payload []byte) {\n\tvar event github.IssueCommentEvent\n\tif err := json.Unmarshal(payload, &event); err != nil {\n\t\tfmt.Printf(\"Error unmarshaling issue comment event: %v\", err)\n\t\treturn\n\t}\n\n\tissue := event.GetIssue()\n\tif issue == nil || !issue.IsPullRequest() {\n\t\treturn\n\t}\n\n\trepoName := event.GetRepo().GetFullName()\n\tprNumber := issue.GetNumber()\n\n\t// Check if the pull request is being tracked\n\tif !state.State.IsPullRequestTracked(repoName, prNumber) {\n\t\treturn\n\t}\n\n\tcomment := event.GetComment().GetBody()\n\n\tgo func() {\n\t\tstate.State.Mu.RLock()\n\t\ttoken := state.State.Settings.GitHubToken\n\t\tstate.State.Mu.RUnlock()\n\n\t\tif token == \"\" {\n\t\t\tfmt.Println(\"GitHub token not configured\")\n\t\t\treturn\n\t\t}\n\n\t\tcommitMessage := fmt.Sprintf(\"Address comment: %s\", comment)\n\t\terr := github.AddCommitToPullRequest(token, repoName, prNumber, commitMessage)\n\t\tif err != nil {\n\t\t\tfmt.Printf(\"Error adding commit to pull request: %v\", err)\n\t\t}\n\t}()\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/handlers/github.go]}"}
