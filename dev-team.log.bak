s being tracked, remove it.\n\t\tif _, ok := state.State.TrackedPullRequests[repoPath]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, repoPath)\n\t\t\tfmt.Printf(\"No longer tracking pull request %d in %s\\n\", prNumber, repoPath)\n\t\t}\n\t}\n\n\t// Handle closed and merged events.\n\taction := event.GetAction()\n\tif action == \"closed\" {\n\t\tdelete(state.State.TrackedPullRequests, repoPath)\n\t\tfmt.Printf(\"Pull request %d in %s closed, no longer tracking\\n\", prNumber, repoPath)\n\t}\n\n\tif pr.GetMerged() {\n\t\tdelete(state.State.TrackedPullRequests, repoPath)\n\t\tfmt.Printf(\"Pull request %d in %s merged, no longer tracking\\n\", prNumber, repoPath)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handleIssueCommentEvent(payload []byte, w http.ResponseWriter) {\n\tvar event github.IssueCommentEvent\n\tif err := json.Unmarshal(payload, &event); err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error unmarshaling issue comment event: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tissue := event.GetIssue()\n\tif !issue.IsPullRequest() {\n\t\t// Only handle comments on pull requests.\n\t\tw.WriteHeader(http.StatusOK)\n\t\treturn\n\t}\n\n\trepo := event.GetRepo()\n\trepoPath := repo.GetFullName()\n\tissueNumber := issue.GetNumber()\n\n\tstate.State.Mu.RLock()\n\t_, tracked := state.State.TrackedPullRequests[repoPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !tracked {\n\t\t// Only handle comments on tracked pull requests.\n\t\tw.WriteHeader(http.StatusOK)\n\t\treturn\n\t}\n\n\tcomment := event.GetComment()\n\tcommentBody := comment.GetBody()\n\n\t// Fetch the settings to access the GitHub token\n\tstate.State.Mu.RLock()\n\tgithubToken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif githubToken == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Create a new commit to address the comment.\n\tcommitMessage := fmt.Sprintf(\"Address comment: %s\", commentBody)\n\n\t// Get the repository.\n\tstate.State.Mu.RLock()\n\trepoInstance, exists := state.State.Repositories[repoPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tif err := repoInstance.CreateCommit(githubToken, strconv.Itoa(issueNumber), commitMessage); err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error creating commit: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tfmt.Printf(\"Created commit for comment on pull request %d in %s\\n\", issueNumber, repoPath)\n\tw.WriteHeader(http.StatusOK)\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/handlers/github.go]}"}
