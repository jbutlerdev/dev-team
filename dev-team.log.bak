{"level":"info","ts":1738791940.566006,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"41093767-cbeb-48b2-88c0-371cd64079bf","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package scheduler\n\nimport (\n\t\"fmt\"\n\t\"log\"\n\t\"strings\"\n\t\"sync\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/robfig/cron/v3\"\n)\n\ntype Task struct {\n\tID       cron.EntryID\n\tSchedule string\n\tAction   func()\n}\n\ntype Scheduler struct {\n\tcron  *cron.Cron\n\ttasks map[string]*Task\n\tmu    sync.RWMutex\n}\n\nfunc NewScheduler() *Scheduler {\n\treturn &Scheduler{\n\t\tcron:  cron.New(),\n\t\ttasks: make(map[string]*Task),\n\t}\n}\n\nfunc (s *Scheduler) Start() {\n\ts.cron.Start()\n}\n\nfunc (s *Scheduler) Stop() {\n\ts.cron.Stop()\n}\n\nfunc (s *Scheduler) AddTask(key string, schedule string, action func()) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\n\t// Remove existing task if it exists\n\tif existingTask, exists := s.tasks[key]; exists {\n\t\ts.cron.Remove(existingTask.ID)\n\t\tdelete(s.tasks, key)\n\t}\n\n\tid, err := s.cron.AddFunc(schedule, func() {\n\t\tlog.Printf(\"Running scheduled task for %s\", key)\n\t\taction()\n\t})\n\n\tif err != nil {\n\t\treturn err\n\t}\n\n\ts.tasks[key] = &Task{\n\t\tID:       id,\n\t\tSchedule: schedule,\n\t\tAction:   action,\n\t}\n\n\treturn nil\n}\n\nfunc (s *Scheduler) RemoveTask(key string) {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\n\tif task, exists := s.tasks[key]; exists {\n\t\ts.cron.Remove(task.ID)\n\t\tdelete(s.tasks, key)\n\t}\n}\n\nfunc (s *Scheduler) UpdateTask(key string, schedule string, action func()) error {\n\treturn s.AddTask(key, schedule, action)\n}\n\nfunc TrackPullRequests(remotePath, label, githubToken string) {\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\tprs, err := state.State.Repositories[remotePath].FetchPullRequests(remotePath, label, githubToken)\n\tif err != nil {\n\t\tlog.Printf(\"Error fetching pull requests: %v\", err)\n\t\treturn\n\t}\n\n\tif state.State.TrackedPullRequests == nil {\n\t\tstate.State.TrackedPullRequests = make(map[string]bool)\n\t}\n\n\t// Iterate through tracked pull requests and check if they are still valid\n\tfor prURL := range state.State.TrackedPullRequests {\n\t\tprStillValid := false\n\t\tfor _, pr := range prs {\n\t\t\tif pr.HTMLURL == prURL {\n\t\t\t\tprStillValid = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !prStillValid {\n\t\t\t// PR is no longer valid (closed, merged, label removed)\n\t\t\tdelete(state.State.TrackedPullRequests, prURL)\n\t\t\tlog.Printf(\"Removing tracked pull request: %s\", prURL)\n\t\t}\n\t}\n\n\t// Iterate through fetched pull requests and add new ones to the tracked list\n\tfor _, pr := range prs {\n\t\tif _, tracked := state.State.TrackedPullRequests[pr.HTMLURL]; !tracked {\n\t\t\tstate.State.TrackedPullRequests[pr.HTMLURL] = true\n\t\t\tlog.Printf(\"Tracking new pull request: %s\", pr.HTMLURL)\n\t\t\t// TODO: Add logic to add a commit for new comments\n\t\t}\n\t}\n}\n\n\nfunc (s *Scheduler) AddRepoTask(key string, schedule string, remotePath string, label string, githubToken string) error {\n\treturn s.AddTask(key, schedule, func() {\n\t\tTrackPullRequests(remotePath, label, githubToken)\n\t})\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/scheduler/scheduler.go]}"}
