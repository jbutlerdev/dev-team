 make(map[string]*RepositoryState),\n\tSettings:            Settings{},\n\tTrackedPullRequests: make(map[int]*TrackedPullRequest),\n\tScheduler:           scheduler.NewScheduler(),\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/state/state.go]}"}
