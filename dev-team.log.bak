sInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubPullRequest(w http.ResponseWriter, r *http.Request) {\n\tvar payload map[string]interface{}\n\terr := json.NewDecoder(r.Body).Decode(&payload)\n\tif err != nil {\n\t\thttp.Error(w, \"Error decoding request body\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\taction, ok := payload[\"action\"].(string)\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'action' in payload\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tpullRequest, ok := payload[\"pull_request\"].(map[string]interface{})\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'pull_request' in payload\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tnumber, ok := pullRequest[\"number\"].(float64)\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'number' in pull_request\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tpullRequestID := int(number)\n\n\trepositoryData, ok := payload[\"repository\"].(map[string]interface{})\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'repository' in payload\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tname, ok := repositoryData[\"name\"].(string)\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'name' in repository\", http.StatusBadRequest)\n\t\treturn\n\t}\n\towner, ok := repositoryData[\"owner\"].(map[string]interface{})\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'owner' in repository\", http.StatusBadRequest)\n\t\treturn\n\t}\n\townerName, ok := owner[\"login\"].(string)\n\tif !ok {\n\t\thttp.Error(w, \"Missing 'login' in owner\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\trepositoryPath := filepath.Join(ownerName, name)\n\n\t// Fetch labels for the pull request\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tlabels, err := github.GetPullRequestLabels(token, ownerName, name, pullRequestID)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching pull request labels: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\thasDevTeamLabel := false\n\tfor _, label := range labels {\n\t\tif label == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\tswitch action {\n\tcase \"opened\", \"synchronize\", \"reopened\", \"labeled\":\n\t\tif hasDevTeamLabel {\n\t\t\tstate.State.AddTrackedPullRequest(repositoryPath, pullRequestID)\n\t\t}\n\tcase \"closed\", \"merged\", \"unlabeled\":\n\t\t// If the action is \"unlabeled\", we need to check if the `dev-team` label was removed.\n\t\tif action == \"unlabeled\" {\n\t\t\tlabelEvent, ok := payload[\"label\"].(map[string]interface{})\n\t\t\tif ok {\n\t\t\t\tlabelName, ok := labelEvent[\"name\"].(string)\n\t\t\t\tif ok && labelName == \"dev-team\" {\n\t\t\t\t\tstate.State.RemoveTrackedPullRequest(pullRequestID)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tfmt.Println(\"Warning: 'label' field missing in 'unlabeled' event.\")\n\t\t\t}\n\t\t} else {\n\t\t\tstate.State.RemoveTrackedPullRequest(pullRequestID)\n\t\t}\n\tcase \"created\":\n\t\t// Handle comment creation on tracked pull requests\n\t\tif state.State.IsTrackedPullRequest(pullRequestID) {\n\t\t\tcomment, ok := payload[\"comment\"].(map[string]interface{})\n\t\t\tif !ok {\n\t\t\t\thttp.Error(w, \"Missing 'comment' in payload\", http.StatusBadRequest)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tbody, ok := comment[\"body\"].(string)\n\t\t\tif !ok {\n\t\t\t\thttp.Error(w, \"Missing 'body' in comment\", http.StatusBadRequest)\n\t\t\t\treturn\n\t\t\t}\n\t\t\t// Generate a commit message based on the comment\n\t\t\tcommitMessage := fmt.Sprintf(\"Address comment: %s\", body)\n\n\t\t\t// Add a commit to the pull request\n\t\t\terr = github.AddCommitToPullRequest(token, ownerName, name, pullRequestID, commitMessage)\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, fmt.Sprintf(\"Error adding commit to pull request: %v\", err), http.StatusInternalServerError)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/handlers/github.go]}"}
