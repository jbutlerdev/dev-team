{"level":"info","ts":1738783870.2665653,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"1ba3636d-8e7a-4989-af6e-e4a2ebc72679","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package state\n\nimport (\n\t\"sync\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/scheduler\"\n\t\"github.com/jbutlerdev/dev-team/internal/settings\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n\t\"github.com/jbutlerdev/genai\"\n)\n\nvar State *AppState\n\ntype AppState struct {\n\tRepositories map[string]*repository.Repository `json:\"repositories\"`\n\tSettings     settings.Settings                 `json:\"settings\"`\n\tScheduler    *scheduler.Scheduler\n\tMu           sync.RWMutex\n\tGenAI        *genai.Provider\n\tTrackedPRs   map[string]map[int]TrackedPRData `json:\"tracked_prs\"` // repoPath -> prNumber -> TrackedPRData\n}\n\ntype TrackedPRData struct {\n\tPR                      github.PullRequest `json:\"pr\"`\n\tLastProcessedCommentID int64              `json:\"last_processed_comment_id\"`\n}\n path:/data/jbutler/tmpgit/jbutlerdev/dev-team/internal/state/state.go]}"}
