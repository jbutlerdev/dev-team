\n\tif os.Getenv(\"GITHUB_ACTIONS\") == \"true\" {\n\t\tclient = github.NewClient(hc)\n\t\terr = nil\n\t}\n\n\tif err != nil {\n\t\treturn err\n\t}\n\n\towner, name := splitRepoName(repoName)\n\n\t// Get the pull request.\n\tpr, _, err := client.PullRequests.Get(ctx, owner, name, issueNumber)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting pull request: %w\", err)\n\t}\n\n\t// Get the base branch.\n\tbaseBranch := pr.GetBase().GetRef()\n\n\t// Get the commit SHA of the base branch.\n\tbaseCommit, _, err := client.Git.GetRef(ctx, owner, name, \"refs/heads/\"+baseBranch)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error getting base commit: %w\", err)\n\t}\n\n\n\t// Create a tree with the changes.\n\tcontent := fmt.Sprintf(\"Addressing comment: %s\", commentBody)\n\tfilename := fmt.Sprintf(\"comment-%d.txt\", issueNumber)\n\n\n\ttree, _, err := client.Git.CreateTree(ctx, owner, name, baseCommit.GetObject().GetSHA(), []*github.TreeEntry{\n\t\t{\n\t\t\tPath:    github.String(filename),\n\t\t\tType:    github.String(\"blob\"),\n\t\t\tMode:    github.String(\"100644\"),\n\t\t\tContent: github.String(content),\n\t\t},\n\t})\n\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating tree: %w\", err)\n\t}\n\n\t// Create a commit.\n\tcommitMessage := fmt.Sprintf(\"Addressing comment on pull request #%d\", issueNumber)\n\n\tcommit := &github.Commit{\n\t\tMessage: github.String(commitMessage),\n\t\tTree:    tree,\n\t\tParents: []*github.Commit{\n\t\t\t{SHA: github.String(baseCommit.GetObject().GetSHA())},\n\t\t},\n\t}\n\n\n\n\tnewCommit, _, err := client.Git.CreateCommit(ctx, owner, name, commit, nil)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating commit: %w\", err)\n\t}\n\n\t// Update the pull request branch.\n\n\tref := &github.Reference{\n\t\tRef: github.String(\"refs/heads/\" + baseBranch),\n\t\tObject: &github.GitObject{\n\t\t\tSHA: newCommit.SHA,\n\t\t},\n\t}\n\n\t_, _, err = client.Git.UpdateRef(ctx, owner, name, ref, false)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error updating ref: %w\", err)\n\t}\n\n\treturn nil\n}\n\n\nfunc splitRepoName(repoName string) (string, string) {\n\tsplit := os.PathSeparator\n\tif os.PathSeparator == '\\\\' {\n\t\tsplit = '/'\n\t}\n\tfor i := len(repoName) - 1; i >= 0; i-- {\n\t\tif repoName[i] == uint8(split) {\n\t\t\treturn repoName[:i], repoName[i+1:]\n\t\t}\n\t}\n\treturn \"\", \"\"\n}\n\nfunc CreateDraftPR(repoPath string, token string, input GitHubPRInput) error {\n\tctx := context.Background()\n\tsource := oauth2.StaticTokenSource(\n\t\t&oauth2.Token{\n\t\t\tAccessToken: token,\n\t\t},\n\t)\n\thc := oauth2.NewClient(ctx, source)\n\n\tclient, err := github.NewEnterpriseClient(\n\t\t\"https://github.example.com/api/v3\",\n\t\t\"https://github.example.com/api/v3\",\n\t\thc,\n\t)\n\tif os.Getenv(\"GITHUB_ACTIONS\") == \"true\" {\n\t\tclient = github.NewClient(hc)\n\t\terr = nil\n\t}\n\n\tif err != nil {\n\t\treturn err\n\t}\n\n\towner, name := splitRepoName(repoPath)\n\n\tnewPR := &github.NewPullRequest{\n\t\tTitle:               github.String(input.Title),\n\t\tHead:                github.String(input.BaseBranch),\n\t\tBase:                github.String(\"main\"), // Assuming main as the target branch\n\t\tBody:                github.String(input.Body),\n\t\tDraft:               github.Bool(true),\n\t}\n\n\t_, _, err = client.PullRequests.Create(ctx, owner, name, newPR)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"error creating pull request: %w\", err)\n\t}\n\n\treturn nil\n}\n path:pkg/github/github.go]}"}
