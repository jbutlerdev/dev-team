{"level":"info","ts":1738781187.4720197,"logger":"genai-provider.chat","caller":"genai/gemini.go:78","msg":"Handling text","model":"models/gemini-2.0-flash-exp","id":"e6424d04-1ea0-4829-a69c-3d5e9bf613c1","content":"I don't see any explicit webhook handling in `cmd/dev-team/main.go`. It's possible that the webhook handling is implicitly done through one of the existing handlers, or that it's missing entirely.\n\nGiven the information available, I'll proceed with the following assumptions and steps:\n\n1.  **Assume a dedicated webhook handler is needed:** I'll create a new handler function in `internal/handlers/github.go` to handle GitHub webhook events. This handler will be responsible for:\n    *   Identifying pull request events.\n    *   Checking for the `dev-team` label.\n    *   Tracking pull requests based on the label.\n    *   Handling comment events for tracked pull requests.\n    *   Updating the state of tracked pull requests when they are closed, merged, or the label is removed.\n2.  **Modify `cmd/dev-team/main.go`:** I'll add a new route in `cmd/dev-team/main.go` to map a specific path (e.g., `/github/webhook`) to the new webhook handler.\n3.  **Modify `internal/state/state.go`:** I'll update the `internal/state/state.go` file to add a data structure for storing the state of tracked pull requests. This will likely be a map that stores pull request IDs and their associated information (e.g., repository, branch, etc.).\n4.  **Utilize `pkg/github/github.go`:** I'll use the functions in `pkg/github/github.go` to interact with the GitHub API, such as fetching pull request details, adding commits, and managing labels.\n\nHere's the first step: I'll add a new handler function to `internal/handlers/github.go` to handle GitHub webhook events.\n\n"}
{"level":"info","ts":1738781187.472045,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"e6424d04-1ea0-4829-a69c-3d5e9bf613c1","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"path/filepath\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\t\"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n\t\"log\"\n)\n\nfunc HandleGitHubRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\trepos, err := github.FetchRepositories(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching repositories: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\terr = json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubIssues(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tabsPath, err := filepath.Abs(path)\n\tif err != nil {\n\t\thttp.Error(w, \"Invalid path\", http.StatusBadRequest)\n\t\treturn\n\t}\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[absPath]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\ttoken := state.State.Settings.GitHubToken\n\tstate.State.Mu.RUnlock()\n\n\tif token == \"\" {\n\t\thttp.Error(w, \"GitHub token not configured\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = repo.UpdateIssues(token)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error fetching issues: %v\", err), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tissues := make([]repository.Issue, 0, len(repo.Issues))\n\tfor _, issue := range repo.Issues {\n\t\tissues = append(issues, *issue)\n\t}\n\n\terr = json.NewEncoder(w).Encode(issues)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleGitHubWebhook(w http.ResponseWriter, r *http.Request) {\n\teventType := r.Header.Get(\"X-GitHub-Event\")\n\n\tswitch eventType {\n\tcase \"pull_request\":\n\t\thandlePullRequestEvent(w, r)\n\tcase \"issue_comment\":\n\t\thandleIssueCommentEvent(w, r)\n\tdefault:\n\t\tw.WriteHeader(http.StatusOK)\n\t}\n}\n\nfunc handlePullRequestEvent(w http.ResponseWriter, r *http.Request) {\n\tvar event github.PullRequestEvent\n\terr := json.NewDecoder(r.Body).Decode(&event)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding pull request event: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\t// Check if the pull request has the 'dev-team' label\n\thasDevTeamLabel := false\n\tfor _, label := range event.PullRequest.Labels {\n\t\tif label.Name == \"dev-team\" {\n\t\t\thasDevTeamLabel = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\tif hasDevTeamLabel {\n\t\t// Track the pull request\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; !ok {\n\t\t\tstate.State.TrackedPullRequests[event.PullRequest.ID] = &state.TrackedPullRequest{\n\t\t\t\tRepoPath:      event.Repository.FullName,\n\t\t\t\tPullRequestID: event.PullRequest.ID,\n\t\t\t\t// Add other relevant information here\n\t\t\t}\n\t\t\tlog.Printf(\"Tracking pull request %d\", event.PullRequest.ID)\n\t\t}\n\t} else {\n\t\t// Stop tracking the pull request if it was previously tracked\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, event.PullRequest.ID)\n\t\t\tlog.Printf(\"No longer tracking pull request %d\", event.PullRequest.ID)\n\t\t}\n\t}\n\n\t// Also stop tracking if the PR is closed or merged\n\tif event.Action == \"closed\" || event.PullRequest.Merged {\n\t\tif _, ok := state.State.TrackedPullRequests[event.PullRequest.ID]; ok {\n\t\t\tdelete(state.State.TrackedPullRequests, event.PullRequest.ID)\n\t\t\tlog.Printf(\"No longer tracking pull request %d because it was closed or merged\", event.PullRequest.ID)\n\t\t}\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n\nfunc handleIssueCommentEvent(w http.ResponseWriter, r *http.Request) {\n\tvar event github.IssueCommentEvent\n\terr := json.NewDecoder(r.Body).Decode(&event)\n\tif err != nil {\n\t\thttp.Error(w, fmt.Sprintf(\"Error decoding issue comment event: %v\", err), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t// Check if the comment is on a tracked pull request\n\tif _, ok := state.State.TrackedPullRequests[event.Issue.ID]; ok {\n\t\t// Add a new commit to the pull request that addresses the comment\n\t\t// This is where you would call the GitHub API to create a commit\n\t\t// and push it to the pull request's branch.\n\t\tlog.Printf(\"Adding commit to pull request %d in response to comment\", event.Issue.ID)\n\n\t\t// Placeholder for adding commit logic\n\t\t// github.AddCommitToPullRequest(event.Repository.FullName, event.Issue.Number, event.Comment.Body)\n\t}\n\n\tw.WriteHeader(http.StatusOK)\n}\n path:internal/handlers/github.go]}"}
