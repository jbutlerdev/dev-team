edPRs[prNumber].LastProcessedCommentID {\n\t\t\t\t\t\tlog.Printf(\"New comment on PR %d in %s: %s\", trackedPRs[prNumber].PR.Number, repoPath, comment.GetBody())\n\t\t\t\t\t\t// Generate a patch using the GenAI provider\n\t\t\t\t\t\tpatch, err := generatePatch(repoPath, trackedPRs[prNumber].PR.Number, comment.GetBody())\n\t\t\t\t\t\tif err != nil {\n\t\t\t\t\t\t\tlog.Printf(\"Error generating patch for PR %d in %s: %v\", trackedPRs[prNumber].PR.Number, repoPath, err)\n\t\t\t\t\t\t\tcontinue\n\t\t\t\t\t\t}\n\t\t\t\t\t\tlog.Printf(\"Generated patch: %s\", patch)\n\t\t\t\t\t\t// Update the last processed comment ID\n\t\t\t\t\t\tif comment.GetID() > trackedPRs[prNumber].LastProcessedCommentID {\n\t\t\t\t\t\t\ttrackedPRs[prNumber] = state.TrackedPRData{\n\t\t\t\t\t\t\t\tPR:                      trackedPRs[prNumber].PR,\n\t\t\t\t\t\t\t\tLastProcessedCommentID: comment.GetID(),\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tstate.State.TrackedPRs[repoPath] = trackedPRs\n\t\t}\n\t\tstate.State.Mu.Unlock()\n\t\ttime.Sleep(5 * time.Minute)\n\t}\n}\n\nfunc generatePatch(repoPath string, prNumber int, comment string) (string, error) {\n\t// TODO: Implement the logic to generate a patch using the GenAI provider\n\t// This will involve calling the GenAI API with the code and the comment\n\t// and returning the generated patch.\n\tprompt := fmt.Sprintf(\"Generate a patch to address the following comment on pull request %d in repository %s: %s\", prNumber, repoPath, comment)\n\tresponse, err := state.State.GenAI.GenerateText(prompt)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn response, nil\n}\n\ntype PageData struct {\n\tPage         string\n\tRepositories map[string]*repository.Repository\n\tSettings     settings.Settings\n}\n\nfunc handleHome(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\tdata := PageData{\n\t\tPage:         \"home\",\n\t\tRepositories: state.State.Repositories,\n\t\tSettings:     state.State.Settings,\