{"level":"info","ts":1738784457.1175337,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"3e9135bd-a44b-47df-8439-6853c783528a","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package state\n\nimport (\n\t\"sync\"\n)\n\n// State holds the application's state.\ntype StateData struct {\n\tRepositories map[string]*Repository //github.com/jbutlerdev/dev-team/pkg/repository\n\tGitHubToken string\n\tMu           sync.RWMutex\n\tTrackedPullRequests map[int]bool // Map of pull request IDs to a boolean indicating if they are tracked\n}\n\ntype Repository struct {\n\tPath         string               `json:\"path\"`\n\tSchedule     string               `json:\"schedule\"`\n\tLastSync     time.Time            `json:\"lastSync\"`\n\tState        *Status              `json:\"status,omitempty\"`\n\tIssues       map[int]*Issue       `json:\"issues,omitempty\"`\n\tPullRequests map[int]*PullRequest `json:\"pullRequests,omitempty\"`\n\tRemotePath   string               `json:\"remotePath,omitempty\"`\n}\n\n\ntype Issue struct {\n\tID        int\n\tTitle     string\n\tBody      string\n\tSourceURL string\n}\n\n// PullRequest represents a GitHub pull request.\ntype PullRequest struct {\n\tID        int\n\tTitle     string\n\tBody      string\n\tSourceURL string\n}\n\n\ntype Status struct {\n\tHasChanges    bool\n\tCurrentBranch string\n}\n\n// State is the global application state.\nvar State = &StateData{\n\tRepositories: make(map[string]*Repository),\n\tGitHubToken:     \"\",\n\tTrackedPullRequests: make(map[int]bool),\n}\n\nfunc (s *StateData) TrackPullRequest(pullRequestID int) {\n\ts.TrackedPullRequests[pullRequestID] = true\n}\n\nfunc (s *StateData) UntrackPullRequest(pullRequestID int) {\n\tdelete(s.TrackedPullRequests, pullRequestID)\n}\n\n// IsPullRequestTracked returns true if the pull request is being tracked.\nfunc (s *StateData) IsPullRequestTracked(pullRequestID int) bool {\n\t_, tracked := s.TrackedPullRequests[pullRequestID]\n\treturn tracked\n}\n\nfunc (s *StateData) SetGitHubToken(token string) {\n\ts.Mu.Lock()\n\tdefer s.Mu.Unlock()\n\ts.GitHubToken = token\n}\n path:/internal/state/state.go]}"}
