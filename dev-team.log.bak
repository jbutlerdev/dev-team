{"level":"info","ts":1738786657.0354044,"logger":"genai-provider.chat","caller":"genai/gemini.go:57","msg":"Handling function call","model":"models/gemini-2.0-flash-exp","id":"0e8b7532-e326-4943-84b2-3cf914eedb3d","name":"writeFile","content":"{writeFile map[basePath:/data/jbutler/tmpgit/jbutlerdev/dev-team content:package handlers\n\nimport (\n\t\"encoding/json\"\n\t\"net/http\"\n\n\t\"github.com/jbutlerdev/dev-team/internal/config\"\n\t\"github.com/jbutlerdev/dev-team/internal/state\"\n\tinternalgithub \"github.com/jbutlerdev/dev-team/pkg/github\"\n\t\"github.com/jbutlerdev/dev-team/pkg/repository\"\n)\n\n\ntype RepositoryHandler struct {\n\tRepository *repository.Repository\n}\n\nfunc HandleRepositories(w http.ResponseWriter, r *http.Request) {\n\tstate.State.Mu.RLock()\n\trepos := make([]*repository.Repository, 0, len(state.State.Repositories))\n\tfor _, repo := range state.State.Repositories {\n\t\trepos = append(repos, repo)\n\t}\n\n\tstate.State.Mu.RUnlock()\n\n\terr := json.NewEncoder(w).Encode(repos)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleCreateRepository(w http.ResponseWriter, r *http.Request) {\n\tbody := struct {\n\t\tPath string `json:\\\"path\\\"`\n\t}{}\n\n\terr := json.NewDecoder(r.Body).Decode(&body)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\trepo := repository.NewRepository(body.Path)\n\terr = repo.Validate()\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t_, exists := state.State.Repositories[repo.Path]\n\tif exists {\n\t\thttp.Error(w, \"Repository already exists\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Repositories[repo.Path] = repo\n\n\tw.WriteHeader(http.StatusCreated)\n}\n\nfunc HandleGetRepository(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[path]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\terr := json.NewEncoder(w).Encode(repo)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\nfunc HandleDeleteRepository(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.Lock()\n\tdefer state.State.Mu.Unlock()\n\n\t_, exists := state.State.Repositories[path]\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tdelete(state.State.Repositories, path)\n\n\tw.WriteHeader(http.StatusNoContent)\n}\n\nfunc HandleGetRepositoryBranches(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[path]\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\trepo.Mu.RLock()\n\tbranches := make([]*repository.Branch, 0, len(repo.Branches))\n\tfor _, branch := range repo.Branches {\n\t\tbranches = append(branches, branch)\n\t}\n\trepo.Mu.RUnlock()\n\n\terr := json.NewEncoder(w).Encode(branches)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n}\n\ntype GitHubPRInput struct {\n\tTitle string `json:\\\"title\\\"`\n\tBody string `json:\\\"body\\\"`\n\tBaseBranch string `json:\\\"baseBranch\\\"`\n}\n\nfunc HandleCreateDraftPR(w http.ResponseWriter, r *http.Request) {\n\tpath := r.URL.Query().Get(\"path\")\n\tif path == \"\" {\n\t\thttp.Error(w, \"Path parameter is required\", http.StatusBadRequest)\n\t\treturn\n\t}\n\n\tvar settings config.Settings\n\n\tstate.State.Mu.RLock()\n\trepo, exists := state.State.Repositories[path]\n\tsettings = state.State.Settings\n\tstate.State.Mu.RUnlock()\n\n\tif !exists {\n\t\thttp.Error(w, \"Repository not found\", http.StatusNotFound)\n\t\treturn\n\t}\n\n\tvar input GitHubPRInput\n\terr := json.NewDecoder(r.Body).Decode(&input)\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\treturn\n\t}\n\n\terr = internalgithub.CreateDraftPR(repo.Path, settings.GitHubToken, internalgithub.GitHubPRInput{\n\t\tTitle: input.Title,\n\t\tBody: input.Body,\n\t\tBaseBranch: input.BaseBranch,\n\t})\n\n\tif err != nil {\n\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)\n\t\treturn\n\t}\n\n\tw.WriteHeader(http.StatusCreated)\n}\n path:internal/handlers/repository.go]}"}
